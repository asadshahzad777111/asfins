# ── ASFins / asfins.com — Production ─────────────────────────
# Copy to .env.local (dev) or Vercel → Settings → Environment Variables

# Public site URL (required on Vercel)
NEXT_PUBLIC_SITE_URL=https://asfins.com

# Shop WhatsApp (country code, no +) — same number as AsFix & Gear
NEXT_PUBLIC_WHATSAPP=923039227000
# Server-side alias used by optional inquiry alerts
SHOP_WHATSAPP_INTL=923039227000
NEXT_PUBLIC_CONTACT_EMAIL=hello@asfins.com

# Optional: Meta WhatsApp Cloud API — staff + customer inquiry alerts
# (skipped silently if unset; contact form still saves to Mongo/admin)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ── Resend (inquiry / quote emails) ───────────────────────────
# Same Resend account as AsFix if shared; FROM must be a verified domain.
# Free test sender: "ASFins" <onboarding@resend.dev> (only delivers to your Resend login email)
RESEND_API_KEY=
RESEND_FROM="ASFins" <noreply@asfins.com>
# Staff inbox for new quote alerts (defaults to NEXT_PUBLIC_CONTACT_EMAIL)
ADMIN_NOTIFY_EMAIL=hello@asfins.com

# ── Admin (CHANGE before live!) ───────────────────────────────
ADMIN_PASSWORD=change-me-strong-password
ADMIN_JWT_SECRET=use-openssl-rand-hex-32-or-long-random-string

# ── MongoDB Atlas (free M0 — 512MB) ───────────────────────────
# Create cluster at mongodb.com → Database name: asfins
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/asfins?retryWrites=true&w=majority
MONGODB_DB_NAME=asfins

# Leave MONGODB_URI empty for local dev → uses data/*.json files

# ── Cloudflare R2 (product images + scene uploads CDN) ───────
# Cloudflare → R2 → Create bucket "asfins-textures"
# → Settings → Public access ON → copy pub-xxxx.r2.dev URL
# → Manage R2 API Tokens → Object Read & Write
# REQUIRED on Vercel — admin scene saves (Advanced wizard) upload to R2
# because the serverless filesystem cannot write public/scenes/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=asfins-textures
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Optional local override: force scene saves to R2 even in npm run dev
# SCENE_STORAGE=r2
