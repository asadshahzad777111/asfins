# ── ASFins / asfins.com — Production ─────────────────────────
# Copy to .env.local (dev) or Vercel → Settings → Environment Variables

# Public site URL (required on Vercel)
NEXT_PUBLIC_SITE_URL=https://asfins.com

# Your WhatsApp (country code, no +) e.g. 923001234567
NEXT_PUBLIC_WHATSAPP=923001234567
NEXT_PUBLIC_CONTACT_EMAIL=hello@asfins.com

# ── Admin (CHANGE before live!) ───────────────────────────────
ADMIN_PASSWORD=change-me-strong-password
ADMIN_JWT_SECRET=use-openssl-rand-hex-32-or-long-random-string

# ── MongoDB Atlas (free M0 — 512MB) ───────────────────────────
# Create cluster at mongodb.com → Database name: asfins
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/asfins?retryWrites=true&w=majority
MONGODB_DB_NAME=asfins

# Leave MONGODB_URI empty for local dev → uses data/*.json files

# ── Cloudflare R2 (product images CDN) ───────────────────────
# Cloudflare → R2 → Create bucket "asfins-textures"
# → Settings → Public access ON → copy pub-xxxx.r2.dev URL
# → Manage R2 API Tokens → Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=asfins-textures
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
